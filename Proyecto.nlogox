<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.0-beta2" snapToGrid="false">
  <code><![CDATA[extensions [ table ]

globals [
  entry-point
  exit-point
  checkout-patches
  product-patches
  total-customers-finished
  total-shopping-time
  avg-shopping-time
  avg-queue-length
  product-data
  num-products
  popular-item-id
  registro-transacciones
  total-impulse-items    ; Suma total de items impulsivos comprados por todos los clientes que salieron
  avg-impulse-items      ; El promedio actual (total-impulse-items / total-customers-finished)
]

patches-own [
  p-type
  product-id
  visits-per-patch
  status
]

breed [customers customer]

customers-own [
  shopping-list
  shopping-cart
  state
  target-product
  entry-time
  exit-time
  time-searching
  items-impulsive
  path-length
  path
  destination
  checkout-timer
  paid?
  pickup-timer
  total-price
]


to setup
  clear-all
  set popular-item-id 1
  if not is-number? num-customers [ set num-customers 10 ]
  if not is-number? rearrangement-policy [ set rearrangement-policy 0 ]
  if not is-number? rearrangement-interval [ set rearrangement-interval 50 ]
  if not is-number? impulse-buy-prob [ set impulse-buy-prob 0.05 ]
  setup-layout
  setup-products
  set total-impulse-items 0
  set avg-impulse-items 0
  set total-customers-finished 0
  set total-shopping-time 0
  set avg-shopping-time 0
  set avg-queue-length 0
  set registro-transacciones []
  
  reset-ticks
end

to go
  if count customers < num-customers [
    create-new-customer
  ]
  ask customers [ customer-step ]
  
  if (rearrangement-policy != 0) and (ticks > 0) and (ticks mod rearrangement-interval = 0) [
    rearrange-layout
  ]
  update-global-metrics

  set-current-plot "Tiempo de Compra"
  plot avg-shopping-time
  
  set-current-plot "Compras Impulsivas"
  plot avg-impulse-items

  tick
end

; CONFIGURACIÓN DEL ENTORNO

to setup-layout
  ask patches [
    set pcolor gray - 2
    set p-type "pasillo"
    set visits-per-patch 0
    set product-id 0
  ]

  ask patches with [ (pxcor mod 5 = 0) and (pycor > -12 and pycor < 16) and (pxcor != 0) ] [
    set pcolor brown
    set p-type "producto"
  ]

  set checkout-patches patches with [ pycor = -15 and abs pxcor < 6 and (pxcor mod 3 = 0) ]
  ask checkout-patches [
    set pcolor yellow
    set p-type "caja"
    set plabel "Caja"
    set status "free"
  ]

  set entry-point patch 14 -16
  ask entry-point [
    set pcolor green
    set p-type "entrada"
    set plabel "ENTRADA"
    set plabel-color white
  ]

  set exit-point patch -14 -16
  ask exit-point [
    set pcolor violet
    set p-type "salida"
    set plabel "SALIDA"
    set plabel-color white
  ]

  set product-patches patches with [ p-type = "producto" ]
end

to setup-products
  set num-products count product-patches
  set product-data []
  let i 1
  
  repeat num-products [
    let price (1 + random-float 99)
    set product-data lput (list i 0 0 0 price) product-data
    set i i + 1
  ]
  
  let available-patches product-patches
  
  foreach product-data [ p ->
    ask one-of available-patches [
      set product-id item 0 p
      set plabel product-id
      set available-patches other available-patches
    ]
  ]
end


to-report get-product-price [p-id]
  ; Buscamos el producto en nuestro global
  let product-info first filter [p -> item 0 p = p-id] product-data
  ; Si lo encontramos, devolvemos el precio ¿
  if product-info != false [
    report item 4 product-info
  ]
  ; Si por alguna razón no lo encontramos, devolvemos 0
  report 0
end


to create-new-customer
  create-customers 1 [
    setxy ([pxcor] of entry-point) ([pycor] of entry-point)
    set shape "person"
    set color white
    set shopping-list generate-shopping-list
    set shopping-cart []
    set state "shopping"
    set target-product 0
    set entry-time ticks
    set time-searching 0
    set items-impulsive 0
    set path-length 0
    set path []
    set destination nobody
    set heading 0
    set checkout-timer 0
    set paid? false
    set pickup-timer 0
  ]
end

to-report generate-shopping-list
  let all-product-ids map [p -> item 0 p] product-data

  let other-product-ids remove popular-item-id all-product-ids
  let base-list n-of (min list (2 + random 3) length other-product-ids) other-product-ids


  if random-float 1.0 < popular-item-prob [
    if not member? popular-item-id base-list [
      set base-list lput popular-item-id base-list
    ]
  ]

  if empty? base-list [
    set base-list (list one-of all-product-ids)
  ]

  report base-list
end

to customer-step
  if empty? path [
    decide-what-to-do
  ]

  follow-path

  if empty? path and destination != nobody [
    perform-arrival-action
  ]
end

to decide-what-to-do
  if state = "shopping" [
    ifelse empty? shopping-list [
      if not paid? [
        set state "going-to-checkout"
        set color green
        decide-what-to-do
      ]
    ] [
      set target-product first shopping-list
      set time-searching 0
      let target-patch one-of patches with [product-id = [target-product] of myself]
      if target-patch != nobody [
        set destination target-patch
        set path find-path patch-here destination
      ]
    ]
  ]

  if state = "picking-up-item" [
    set pickup-timer pickup-timer - 1
    if pickup-timer <= 0 [
      pick-up-product
      set state "shopping"
    ]
  ]

  if state = "going-to-checkout" [
    let target-checkout min-one-of checkout-patches with [status = "free"] [distance myself]
    if target-checkout != nobody [
      set destination target-checkout
      set path find-path patch-here destination
    ]
  ]

  if state = "in-queue" [
    ask patch-here [ set status "busy" ]

    if checkout-timer = 0 [
      let base-time 5  
      let time-per-item 2 
      let num-items length shopping-cart
      let processing-time (base-time + (time-per-item * num-items))
      
      set checkout-timer processing-time
    ]

    set checkout-timer checkout-timer - 1

    if checkout-timer <= 0 [
      set paid? true
      set state "leaving"
      set color white
      ask patch-here [ set status "free" ]
    ]
  ]

  if state = "leaving" [
    set destination exit-point
    set path find-path patch-here destination
  ]
end


to follow-path
  if not empty? path [
    let next-step first path
    if patch-here != next-step [
      face next-step
      move-to next-step
      set path-length path-length + 1
    ]
    set path but-first path
  ]
end

to perform-arrival-action
  if state = "shopping" [
    set state "picking-up-item"
    set pickup-timer (3 + random 4)
    check-for-impulse-buy
  ]

  if state = "going-to-checkout" [
    set state "in-queue"
  ]

  if state = "leaving" [
    if patch-here = exit-point [
      record-final-stats
      die
    ]
  ]
  set destination nobody
end

to pick-up-product
  set shopping-cart lput target-product shopping-cart
  set shopping-list remove-item (position target-product shopping-list) shopping-list
  update-product-data target-product time-searching
  set target-product 0
  set color white
end

to check-for-impulse-buy
  let potential-impulse-patches neighbors with [p-type = "producto"]


  foreach patches-to-list potential-impulse-patches [ a-patch ->
    if random-float 1.0 < impulse-buy-prob [
      let impulsive-item [product-id] of a-patch
      if not member? impulsive-item shopping-cart [
        set shopping-cart lput impulsive-item shopping-cart
        set items-impulsive items-impulsive + 1
        set color red
      ]
    ]
  ]
end

to-report patches-to-list [ps]
  report [self] of ps
end


to wait-in-queue
  let my-checkout patch-here
  if count other customers-here = 0 and random 10 = 0 [
    set state "leaving"
  ]
end


to-report find-path [start-patch target-patch]
  if target-patch = nobody [ report [] ]

  let valid-goals nobody
  ifelse [p-type] of target-patch = "producto" [

    let target-neighbors [neighbors] of target-patch

    set valid-goals target-neighbors with [p-type != "producto"]

  ]
  [
    set valid-goals patch-set target-patch
  ]

  if not any? valid-goals [ report [] ]

  let queue (list start-patch)
  let visited-patches patch-set start-patch
  let came-from table:make

  while [not empty? queue] [
    let current-patch first queue
    set queue but-first queue

    if member? current-patch valid-goals [
      let path-reversed (list current-patch)
      let current-key (list [pxcor] of current-patch [pycor] of current-patch)
      while [table:has-key? came-from current-key] [
        set current-patch table:get came-from current-key
        set path-reversed lput current-patch path-reversed
        set current-key (list [pxcor] of current-patch [pycor] of current-patch)
      ]
      report but-first reverse path-reversed
    ]

    let current-neighbors [neighbors] of current-patch
    let valid-neighbors current-neighbors with [(p-type != "producto") and not member? self visited-patches]

    ask valid-neighbors [
      set visited-patches (patch-set visited-patches self)
      set queue lput self queue
      let key (list [pxcor] of self [pycor] of self)
      table:put came-from key current-patch
    ]
  ]

  report []
end


to update-product-data [prod-id search-duration]
  let index prod-id - 1
  let old-data item index product-data
  
  let new-demand (item 1 old-data) + 1
  let new-search-time (item 2 old-data) + search-duration
  let new-num-searches (item 3 old-data) + 1
  
  let price (item 4 old-data) 

  set product-data replace-item index product-data (list prod-id new-demand new-search-time new-num-searches price)
end

to-report bubble-sort-by-score [list-to-sort]
  if length list-to-sort < 2 [ report list-to-sort ]
  let sorted-list list-to-sort
  let n length sorted-list
  repeat (n - 1) [
    let i 0
    while [ i < n - 1 ] [
      let item1 item i sorted-list
      let item2 item (i + 1) sorted-list
      if ( item 1 item2 ) > ( item 1 item1 ) [
        set sorted-list replace-item i sorted-list item2
        set sorted-list replace-item (i + 1) sorted-list item1
      ]
      set i i + 1
    ]
  ]
  report sorted-list
end

to-report bubble-sort-by-distance [patch-list]
  if length patch-list < 2 [ report patch-list ]
  let sorted-list patch-list
  let n length sorted-list
  let entryx [pxcor] of entry-point
  let entryy [pycor] of entry-point
  repeat (n - 1) [
    let i 0
    while [ i < n - 1 ] [
      let p1 item i sorted-list
      let p2 item (i + 1) sorted-list
      let dx1 ([pxcor] of p1) - entryx
      let dy1 ([pycor] of p1) - entryy
      let d1 dx1 * dx1 + dy1 * dy1
      let dx2 ([pxcor] of p2) - entryx
      let dy2 ([pycor] of p2) - entryy
      let d2 dx2 * dx2 + dy2 * dy2
      if d1 > d2 [
        set sorted-list replace-item i sorted-list p2
        set sorted-list replace-item (i + 1) sorted-list p1
      ]
      set i i + 1
    ]
  ]
  report sorted-list
end


to rearrange-layout
  let product-metrics []
  set total-impulse-items 0
  set avg-impulse-items 0
  foreach product-data [ p ->
    let p-id item 0 p
    let p-demand item 1 p
    let p-total-search-time item 2 p
    let p-num-searches item 3 p
    let p-avg-search-time ifelse-value (p-num-searches > 0) [ p-total-search-time / p-num-searches ] [ 0 ]
    let score 0
    if rearrangement-policy = 1 [ set score p-demand * p-avg-search-time ]
    if rearrangement-policy = 2 [ set score (- p-demand) ]
    if rearrangement-policy = 3 [ set score random-float 1.0 ]
    set product-metrics lput (list p-id score) product-metrics
  ]

  let sorted-products bubble-sort-by-score product-metrics
  let patch-list [self] of product-patches
  let locations bubble-sort-by-distance patch-list
  let i 0
  while [ i < length sorted-products and i < length locations ] [
    let prod-info item i sorted-products
    let loc item i locations
    ask loc [
      set product-id item 0 prod-info
      set plabel product-id
    ]
    set i i + 1
  ]
end

to-report compare-products-by-score [p1 p2]
  report (item 1 p1) > (item 1 p2)
end

to-report compare-patches-by-distance [p1 p2]
  let d1 ([distance entry-point] of p1)
  let d2 ([distance entry-point] of p2)
  report d1 < d2
end

to update-global-metrics
  set avg-shopping-time ifelse-value (total-customers-finished > 0)
  [ total-shopping-time / total-customers-finished ]
  [ 0 ]
  let total-queue-length sum [ count customers-here ] of checkout-patches
  if ticks > 0 [
    set avg-queue-length (avg-queue-length * (ticks - 1) + total-queue-length) / ticks
  ]
  ask customers [
    ask patch-here [ set visits-per-patch visits-per-patch + 1 ]
  ]
  update-heatmap
end

to record-final-stats
  set exit-time ticks
  let time-in-store exit-time - entry-time

  ; Calcular el precio total de la compra
  set total-price 0
  foreach shopping-cart [ item-id ->
    set total-price (total-price + get-product-price item-id)
  ]
  
  
  set total-impulse-items total-impulse-items + items-impulsive
  
  ; Aumentamos el contador de clientes finalizados
  set total-customers-finished total-customers-finished + 1

  
  ; Calculamos el nuevo promedio (evitando división por cero)
  if total-customers-finished > 0 [
    set avg-impulse-items total-impulse-items / total-customers-finished
  ]
  ;

  ; Guarda la boleta en el registro global
  ; Formato: [tiempo-en-tienda, precio-total, cantidad-de-items]
  let boleta (list time-in-store total-price (length shopping-cart))
  set registro-transacciones lput boleta registro-transacciones
  
  ; Imprimir la boleta en la consola para verla en tiempo real
  print (word "Cliente finalizado: Tiempo=" time-in-store ", Total=$" precision total-price 2 ", Items=" length shopping-cart)
  print (word "Cliente finalizado: Impulsivos=" items-impulsive " Promedio Global=" precision avg-impulse-items 3)

  set total-customers-finished total-customers-finished + 1
  set total-shopping-time total-shopping-time + time-in-store
end

to update-heatmap
  if max [ visits-per-patch ] of patches > 0 [
    ask patches with [ p-type = "pasillo" ] [
      set pcolor scale-color blue visits-per-patch 0 (max [ visits-per-patch ] of patches)
    ]
  ]
end]]></code>
  <widgets>
    <view x="346" wrappingAllowedX="false" y="116" frameRate="30.0" minPycor="-16" height="431" showTickCounter="true" patchSize="13.061" fontSize="10" wrappingAllowedY="false" width="431" tickCounterLabel="ticks" maxPycor="16" updateMode="0" maxPxcor="16" minPxcor="-16"></view>
    <button x="88" y="46" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="63" display="setup">setup</button>
    <button x="164" y="46" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="63" display="go">go</button>
    <slider x="102" step="1" y="132" max="200" width="172" display="num-customers" height="50" min="10" direction="Horizontal" default="200.0" variable="num-customers"></slider>
    <slider x="102" step="50" y="197" max="1000" width="172" display="rearrangement-interval" height="50" min="100" direction="Horizontal" default="150.0" variable="rearrangement-interval"></slider>
    <slider x="102" step="0.01" y="267" max="1.0" width="150" display="impulse-buy-prob" height="50" min="0.0" direction="Horizontal" default="0.1" variable="impulse-buy-prob"></slider>
    <slider x="101" step="1" y="332" max="3" width="172" display="rearrangement-policy" height="50" min="0" direction="Horizontal" default="2.0" variable="rearrangement-policy"></slider>
    <monitor x="314" precision="0" y="43" height="60" fontSize="11" width="109" display="N° customers">count customers</monitor>
    <monitor x="434" precision="0" y="43" height="60" fontSize="11" width="123" display=" avg-shopping-time">round avg-shopping-time</monitor>
    <monitor x="568" precision="0" y="43" height="60" fontSize="11" width="100" display="ticks">ticks</monitor>
    <plot x="825" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="Ticks por Cliente" y="101" xMin="0.0" height="175" legend="false" xMax="10.0" yMin="0.0" width="230" xAxis="ticks" display="Tiempo de Compra">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-2674135" legend="true">
        <setup></setup>
        <update>plot avg-shopping-time</update>
      </pen>
    </plot>
    <plot x="816" autoPlotX="true" yMax="2.0" autoPlotY="true" yAxis="Clientes en Cola" y="305" xMin="0.0" height="175" legend="false" xMax="10.0" yMin="0.0" width="230" xAxis="ticks" display="Congestión">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-16777216" legend="true">
        <setup></setup>
        <update>plot avg-queue-length</update>
      </pen>
    </plot>
    <slider x="101" step="0.01" y="399" max="1" width="172" display="popular-item-prob" height="50" min="0" direction="Horizontal" default="0.9" variable="popular-item-prob"></slider>
    <plot x="1112" autoPlotX="true" yMax="10.0" autoPlotY="true" y="104" xMin="0.0" height="176" legend="false" xMax="10.0" yMin="0.0" width="230" display="Compras Impulsivas">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="pen-0" color="-13210332" legend="true">
        <setup></setup>
        <update>plot total-impulse-items</update>
